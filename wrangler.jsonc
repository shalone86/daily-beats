{
  // Serves this folder as a static site (Cloudflare Workers static assets),
  // plus worker.js for the per-song pages and the sitemap.
  // Workers Builds swaps in the dashboard's Worker name if it differs.
  "name": "daily-beats",
  "main": "worker.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /index.html and /kids.html are where the installed apps open (their
    // scopes, so the music apps under /boba, /pop and /night stay separate
    // apps). worker.js serves them as they are, without the usual redirect.
    "run_worker_first": ["/index.html", "/kids.html"]
  }
}
